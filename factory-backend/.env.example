# ═══════════════════════════════════════════════════
# LogisTMA Factory Backend — Variables d'environnement
# Copier en .env pour le développement local
# ═══════════════════════════════════════════════════

# ─── Application ─────────────────────────────────
PORT=3001
NODE_ENV=development
FACTORY_FRONTEND_URL=http://localhost:5173

# ─── Base de données ──────────────────────────────
FACTORY_DB_PATH=./data/factory.sqlite

# ─── Sécurité ─────────────────────────────────────
# Clé AES-256 pour chiffrement des bot tokens (32 bytes hex)
# Génère avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=votre_cle_hex_64_chars

# Webhook secret pour valider les requêtes du bot factory
FACTORY_WEBHOOK_SECRET=votre_secret_webhook

# Clé API admin (accès routes /admin)
ADMIN_API_KEY=votre_cle_admin_secrete

# ─── Telegram ─────────────────────────────────────
# Bot Telegram de la factory (pas celui des tenants)
FACTORY_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ID Telegram de l'admin de la factory
FACTORY_ADMIN_ID=123456789

# ─── Railway (hébergement des tenants) ───────────
RAILWAY_API_TOKEN=votre_token_railway
RAILWAY_TEAM_ID=votre_team_id_railway

# URL du repo template à cloner pour chaque tenant
TEMPLATE_REPO_URL=https://github.com/logistma/tenant-template

# ─── Cloudflare (DNS tenants) ─────────────────────
CLOUDFLARE_API_TOKEN=votre_token_cloudflare
CLOUDFLARE_ZONE_ID=votre_zone_id_logistma_app

# ─── Stripe (facturation) ─────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs Stripe (créer dans le dashboard Stripe)
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id
